# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5180
CORS_ALLOWED_ORIGINS=http://localhost:5180
LOG_LEVEL=INFO

# Postgres
POSTGRES_DB=factos
POSTGRES_USER=factos
POSTGRES_PASSWORD=factos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis: broker e cache em instâncias separadas
REDIS_BROKER_HOST=redis-broker
REDIS_BROKER_URL=redis://redis-broker:6379/0
CELERY_RESULT_BACKEND=redis://redis-broker:6379/1
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_CACHE_MAXMEMORY=256mb
CACHE_DEFAULT_TIMEOUT=300

# Celery
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_CRAWL_CONCURRENCY=4
CELERY_ANALYSIS_CONCURRENCY=2

# Portas no host
POSTGRES_HOST_PORT=5442
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5180
# Redis publicados no host (backend a correr na máquina, ./start_local.sh)
REDIS_BROKER_HOST_PORT=6390
REDIS_CACHE_HOST_PORT=6391

# Superuser do admin (criado ou actualizado em cada arranque pelo serviço migrate)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=

# LLM: providers da análise e do benchmark (docs/features/analise.md)
# Chaves das APIs (deixar vazio o que não se usa)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ollama: vazio = Ollama Cloud (https://ollama.com); ou um servidor próprio, ex.: http://10.0.0.5:11434
OLLAMA_BASE_URL=
# Chave do Ollama Cloud (ollama.com/settings/keys), enviada em Authorization: Bearer
OLLAMA_API_KEY=
# Contexto por omissão nos modelos Ollama (o default do Ollama corta o prompt)
OLLAMA_DEFAULT_NUM_CTX=16384
# Timeout por pedido (s) e retries das SDKs
LLM_REQUEST_TIMEOUT=600
LLM_MAX_RETRIES=2
# Pasta (no container) com os JSON dos artigos extraídos pelos parsers
ARTICLES_IMPORT_DIR=/data/sites_out

# Crawl
RAW_HTML_ROOT=/data/raw

# LLM (fornecedor e modelo são parâmetros na BD: llm.provider, llm.model)
# OPENAI_BASE_URL=   (só para um endpoint compatível; vazio = api.openai.com)
