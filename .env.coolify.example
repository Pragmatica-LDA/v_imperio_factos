# Variáveis do Factos no Coolify (definir no UI do recurso; nunca commitar valores reais).

# Django
DJANGO_SECRET_KEY=            # gerar: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=factos.exemplo.pt,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://factos.exemplo.pt
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# Postgres: recurso gerido do Coolify com a imagem pgvector/pgvector:0.8.7-pg18-trixie
POSTGRES_HOST=                # nome interno do recurso Postgres no Coolify
POSTGRES_PORT=5432
POSTGRES_DB=factos
POSTGRES_USER=factos
POSTGRES_PASSWORD=

# Superuser do admin e do login do front-end (criado ou actualizado em cada deploy)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Redis e Celery
REDIS_CACHE_MAXMEMORY=256mb
CELERY_CRAWL_CONCURRENCY=4
CELERY_ANALYSIS_CONCURRENCY=2

# LLM (fornecedor e modelo são parâmetros na BD: llm.provider, llm.model)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
